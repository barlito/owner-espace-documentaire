{# Pager of an admin list. Expects: page, list_route, list_params (fixed route parameters), query (active filters as
   query-string parameters) and noun (plural, e.g. "pièces"). Links stay in the results frame. #}
{% if page.pageCount > 1 %}
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 border-t border-gray-50 px-5 py-4 sm:px-6">
        <p class="text-sm text-gray-500">{{ noun|capitalize }} {{ page.range.first }} à {{ page.range.last }} sur {{ page.total }}</p>
        <nav aria-label="Pagination">
            <ul class="flex flex-wrap items-center gap-1">
                {% if page.hasPrevious %}
                    <li><twig:Button variant="ghost" size="sm" icon="lucide:arrow-left" href="{{ path(list_route, list_params|default({})|merge(query)|merge(page.number > 2 ? {page: page.number - 1} : {})) }}" rel="prev">Précédent</twig:Button></li>
                {% endif %}
                {% for number in page.window %}
                    <li>
                        {% if number is null %}
                            <span class="px-2 text-gray-500" aria-hidden="true">…</span>
                        {% elseif number == page.number %}
                            <span class="inline-flex min-w-9 justify-center rounded-lg bg-navy-500 px-3 py-1.5 text-sm font-semibold text-white" aria-current="page"><span class="sr-only">Page </span>{{ number }}</span>
                        {% else %}
                            <a href="{{ path(list_route, list_params|default({})|merge(query)|merge({page: number})) }}" class="inline-flex min-w-9 justify-center rounded-lg px-3 py-1.5 text-sm font-semibold text-navy-500 hover:bg-navy-25"><span class="sr-only">Page </span>{{ number }}</a>
                        {% endif %}
                    </li>
                {% endfor %}
                {% if page.hasNext %}
                    <li><twig:Button variant="ghost" size="sm" href="{{ path(list_route, list_params|default({})|merge(query)|merge({page: page.number + 1})) }}" rel="next">Suivant {{ ux_icon('lucide:arrow-right', {class: 'size-4 shrink-0'}) }}</twig:Button></li>
                {% endif %}
            </ul>
        </nav>
    </div>
{% endif %}
