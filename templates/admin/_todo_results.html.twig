{# Content of the results frame of the to-do list: active filters, the failed documents and the pager. #}
{% set total = page.total %}
{% set chips = [] %}
{% if filters.search %}{% set chips = chips|merge([{href: path('admin_dashboard', filters.without('q').query), label: 'Nom : « ' ~ filters.search ~ ' »', name: 'Nom du fichier'}]) %}{% endif %}
{% if filters.clientId %}{% set chips = chips|merge([{href: path('admin_dashboard', filters.without('client').query), label: selectedClient, name: 'Client'}]) %}{% endif %}
{% if filters.reason %}{% set chips = chips|merge([{href: path('admin_dashboard', filters.without('raison').query), label: filters.reason.label, name: 'Raison'}]) %}{% endif %}

<div data-announcement="{{ total == 0 ? 'Aucune analyse en échec ne correspond.' : total ~ (total > 1 ? ' analyses en échec' : ' analyse en échec') ~ (filters.active ? (total > 1 ? ' correspondent' : ' correspond')) ~ ', page ' ~ page.number ~ ' sur ' ~ page.pageCount ~ '.' }}">
    {{ include('admin/_filter_chips.html.twig', {clear_href: path('admin_dashboard')}) }}

    {% if total == 0 %}
        <twig:Card>
            {% if filters.active %}
                <twig:EmptyState
                    icon="lucide:search-x"
                    title="Aucune analyse en échec ne correspond"
                    description="Modifiez vos critères ou retirez des filtres pour élargir les résultats."
                >
                    <twig:Button variant="secondary" href="{{ path('admin_dashboard') }}" data-turbo-frame="_top">Effacer les filtres</twig:Button>
                </twig:EmptyState>
            {% else %}
                <twig:EmptyState
                    icon="lucide:circle-check"
                    title="Aucune analyse en échec"
                    description="Toutes les pièces reçues ont été analysées ou sont en cours de traitement."
                />
            {% endif %}
        </twig:Card>
    {% else %}
        <twig:Card :padded="false" class="group">
            <ul id="admin-todo-list" class="divide-y divide-gray-50">
                {% for document in page.items %}
                    {% set attempt = document.currentAttempt %}
                    {% set reason = attempt.failureReason %}
                    {# The row id is the target of the live updates: the row disappears once the document is no longer failed. #}
                    <li id="admin-todo-{{ document.id }}" class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2 px-5 py-4 sm:px-6">
                        <div class="min-w-0 flex-1 basis-64">
                            <p class="truncate font-medium text-navy-500" title="{{ document.originalFilename }}">
                                <a href="{{ path('admin_document_show', {id: document.id, retour: app.request.requestUri}) }}" data-turbo-frame="_top" class="hover:underline">{{ document.originalFilename }}</a>
                            </p>
                            <p class="mt-0.5 text-sm text-gray-500">
                                <a href="{{ path('admin_client_show', {id: document.client.id}) }}" data-turbo-frame="_top" class="hover:underline">{{ document.client.name }}</a>
                                · déposée le {{ document.uploadedAt|date('d/m/Y') }}
                            </p>
                        </div>
                        <div class="min-w-0 basis-72 text-sm sm:text-right">
                            <p class="font-medium text-danger-700">{{ reason ? reason.label : 'Cause inconnue' }}</p>
                            <p class="mt-0.5 text-gray-500">
                                Tentative n° {{ attempt.number }}
                                · <time datetime="{{ attempt.finishedAt|date('c') }}" title="{{ attempt.finishedAt|date('d/m/Y \\à H:i:s') }}">{{ attempt.finishedAt|time_ago }}</time>
                                <span class="whitespace-nowrap">({{ attempt.finishedAt|date('d/m/Y \\à H:i') }})</span>
                            </p>
                        </div>
                    </li>
                {% endfor %}
            </ul>
            {# Shown only when live updates removed the last row. #}
            <div class="group-has-[li]:hidden">
                <twig:EmptyState icon="lucide:circle-check" title="Aucune analyse en échec" description="Toutes les analyses de cette page ont été relancées." />
            </div>
            {{ include('admin/_pager.html.twig', {list_route: 'admin_dashboard', list_params: {}, query: filters.query, noun: 'pièces'}) }}
        </twig:Card>
    {% endif %}
</div>
