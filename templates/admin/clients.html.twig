{% extends 'base.html.twig' %}

{% block title %}Clients{% endblock %}

{% block body %}
    <div class="mb-8">
        <h1 class="text-3xl">Clients</h1>
        <p class="mt-1 text-gray-500">Les clients ayant le plus d'analyses en échec sont en tête.</p>
    </div>

    <div data-controller="document-filters" data-action="turbo:frame-load->document-filters#announce">
        <twig:Card class="mb-6">
            <form
                method="get"
                action="{{ path('admin_clients') }}"
                role="search"
                aria-label="Rechercher un client"
                data-document-filters-target="form"
                data-turbo-frame="clients-results"
                data-turbo-action="advance"
                data-action="submit->document-filters#prune"
            >
                <div class="flex flex-wrap items-end gap-3">
                    <div class="min-w-0 flex-1 basis-64">
                        <label for="filter-q" class="mb-1 block text-sm font-medium text-navy-500">Nom du client</label>
                        <div class="relative">
                            {{ ux_icon('lucide:search', {class: 'pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-gray-500'}) }}
                            <input
                                type="search"
                                id="filter-q"
                                name="q"
                                value="{{ search }}"
                                maxlength="100"
                                autocomplete="off"
                                placeholder="Rechercher un client"
                                class="w-full rounded-lg border border-gray-400 bg-white px-3 py-2.5 pl-9"
                                data-document-filters-target="search"
                                data-action="input->document-filters#debounce"
                            >
                        </div>
                    </div>
                    <twig:Button type="submit" variant="secondary" icon="lucide:search">Rechercher</twig:Button>
                </div>
            </form>
        </twig:Card>

        <turbo-frame id="clients-results" data-turbo-action="advance">
            {{ include('admin/_clients_results.html.twig') }}
        </turbo-frame>
    </div>
{% endblock %}
