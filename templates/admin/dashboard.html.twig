{% extends 'base.html.twig' %}

{% block title %}Supervision{% endblock %}

{# The live region announces the failures that appear on the to-do list (see realtime/admin_streams.stream.html.twig). #}
{% block live_scope %}admin-todo{% endblock %}

{% block body %}
    <div class="mb-8">
        <h1 class="text-3xl">Supervision</h1>
        <p class="mt-1 text-gray-500">Les analyses de tous vos clients, et ce qui demande votre intervention.</p>
    </div>

    {{ include('admin/_kpis.html.twig') }}

    <section id="a-traiter" aria-labelledby="todo-title" class="scroll-mt-6">
        <div class="mb-4">
            <h2 id="todo-title" class="text-2xl">À traiter</h2>
            <p class="mt-1 text-sm text-gray-500">Analyses en échec, les plus anciennes d'abord.</p>
        </div>

        {# Same pattern as Mon dossier: the form and the results are siblings, only the results frame is reloaded by a search. #}
        <div data-controller="document-filters" data-action="turbo:frame-load->document-filters#announce">
            {{ include('admin/_todo_filters.html.twig') }}

            {# Filled by the live updates when documents fail while the page is open: the list is not reordered under the cursor. #}
            <div id="admin-todo-notice" class="mb-4 empty:hidden"></div>

            <turbo-frame id="todo-results" data-turbo-action="advance">
                {{ include('admin/_todo_results.html.twig') }}
            </turbo-frame>
        </div>
    </section>

    {{ include('realtime/_admin_stream.html.twig') }}
{% endblock %}
