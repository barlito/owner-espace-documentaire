{% extends 'base.html.twig' %}

{% block title %}{{ document.originalFilename }}{% endblock %}

{# This page announces the changes of its own document only, like the client's. #}
{% block live_scope %}document-{{ document.id }}{% endblock %}

{% block body %}
    <a href="{{ backPath }}" class="mb-4 inline-flex items-center gap-1.5 text-sm font-medium text-navy-200 hover:text-navy-500">
        {{ ux_icon('lucide:arrow-left', {class: 'size-4'}) }}
        {{ backLabel }}
    </a>

    <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 flex-1 basis-72">
            <h1 class="break-words text-2xl sm:text-3xl">{{ document.originalFilename }}</h1>
            <p class="mt-1 text-sm text-gray-500">
                <a href="{{ path('admin_client_show', {id: client.id}) }}" class="inline-flex items-center gap-1 font-medium text-navy-500 hover:underline">
                    {{ ux_icon('lucide:building-2', {class: 'size-4 shrink-0'}) }}
                    {{ client.name }}
                </a>
                · {{ document.size|file_size }}
                · Déposée le {{ document.uploadedAt|date('d/m/Y \\à H:i') }}
                {% if document.uploader %}· par {{ document.uploader.fullName }}{% endif %}
            </p>
        </div>
        <twig:Button href="{{ path('admin_document_file', {id: document.id}) }}" icon="lucide:download">Télécharger</twig:Button>
    </div>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
        <div class="space-y-6">
            {{ include('admin/document/_status.html.twig') }}

            {# Own frame: it carries a CSRF token, so it is loaded by the page (and again after each live update, see
               realtime/admin_streams.stream.html.twig). #}
            {{ include('admin/document/_actions.html.twig') }}

            {{ include('admin/document/_attempts.html.twig') }}
            {{ include('client/document/_preview.html.twig', {preview_route: 'admin_document_preview', file_route: 'admin_document_file'}) }}
        </div>
        <div>
            {{ include('client/document/_timeline.html.twig', {timeline_id: 'admin-document-timeline-' ~ document.id, timeline_entries: admin_timeline(document)}) }}
        </div>
    </div>

    {# Live updates: #admin-document-status-{id}, -actions-, -attempts- and -timeline- are replaced by
       realtime/admin_streams.stream.html.twig. #}
    {{ include('realtime/_admin_stream.html.twig') }}
{% endblock %}
