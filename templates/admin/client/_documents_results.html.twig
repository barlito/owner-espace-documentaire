{# Content of the results frame of a client's folder, seen by an administrator. Same structure as Mon dossier
   (client/_documents_results.html.twig) without what only a client does (uploading) nor its live updates. #}
{% set listRoute = 'admin_client_show' %}
{% set listParams = {id: client.id} %}

{% if folderEmpty %}
    <twig:Card>
        <twig:EmptyState heading="h2" icon="lucide:folder-open" title="Ce client n'a encore déposé aucune pièce" />
    </twig:Card>
{% else %}
    {% set total = page.total %}
    {% set chips = [] %}
    {% if filters.search %}{% set chips = chips|merge([{href: path(listRoute, listParams|merge(filters.without('q').query)), label: 'Nom : « ' ~ filters.search ~ ' »', name: 'Nom du fichier'}]) %}{% endif %}
    {% if filters.status %}{% set chips = chips|merge([{href: path(listRoute, listParams|merge(filters.without('statut').query)), label: filters.status.label, name: 'Statut'}]) %}{% endif %}
    {% if filters.type %}{% set chips = chips|merge([{href: path(listRoute, listParams|merge(filters.without('nature').query)), label: filters.type.label, name: 'Nature'}]) %}{% endif %}
    {% if filters.uncategorized %}{% set chips = chips|merge([{href: path(listRoute, listParams|merge(filters.without('nature').query)), label: 'Non catégorisée', name: 'Nature'}]) %}{% endif %}
    {% if filters.period %}{% set chips = chips|merge([{href: path(listRoute, listParams|merge(filters.without('periode').query)), label: filters.period.label, name: 'Période'}]) %}{% endif %}

    <div data-filters="{{ filters.query|json_encode }}" data-announcement="{{ total == 0 ? 'Aucune pièce ne correspond.' : total ~ (total > 1 ? ' pièces' : ' pièce') ~ (filters.active ? (total > 1 ? ' correspondent' : ' correspond')) ~ ', page ' ~ page.number ~ ' sur ' ~ page.pageCount ~ '.' }}">
        <nav aria-label="Pièces par statut" class="mb-4">
            <ul class="flex flex-wrap gap-2">
                {% for entry in statusCounts|filter(entry => entry.count > 0) %}
                    <li>
                        <a
                            href="{{ path(listRoute, listParams|merge({statut: entry.status.value})) }}"
                            data-turbo-frame="_top"
                            class="inline-flex rounded-full {{ filters.status is same as entry.status ? 'ring-2 ring-navy-500 ring-offset-2' : 'hover:opacity-80' }}"
                            {% if filters.status is same as entry.status %}aria-current="true"{% endif %}
                        >
                            <twig:Badge variant="{{ entry.status.badgeVariant }}" icon="{{ entry.status.icon }}">{{ entry.count }} · {{ entry.status.label }}</twig:Badge>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </nav>

        {{ include('admin/_filter_chips.html.twig', {clear_href: path(listRoute, listParams)}) }}

        {% if total == 0 %}
            <twig:Card>
                <twig:EmptyState
                    icon="lucide:search-x"
                    title="Aucune pièce ne correspond à votre recherche"
                    description="Modifiez les critères ou retirez des filtres pour élargir les résultats."
                >
                    <twig:Button variant="secondary" href="{{ path(listRoute, listParams) }}" data-turbo-frame="_top">Effacer les filtres</twig:Button>
                </twig:EmptyState>
            </twig:Card>
        {% else %}
            <twig:Card :padded="false">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 border-b border-gray-50 px-5 py-4 sm:px-6">
                    <h2 class="text-lg">Pièces</h2>
                    <p class="text-sm text-gray-500">{{ total }} {{ total > 1 ? 'pièces' : 'pièce' }}{% if filters.active %} {{ total > 1 ? 'correspondent' : 'correspond' }}{% endif %}</p>
                </div>
                <ul class="divide-y divide-gray-50">
                    {% for document in page.items %}
                        {{ include('client/_document_row.html.twig', {document_path: path('admin_document_show', {id: document.id, retour: app.request.requestUri})}) }}
                    {% endfor %}
                </ul>
                {{ include('admin/_pager.html.twig', {list_route: listRoute, list_params: listParams, query: filters.query, noun: 'pièces'}) }}
            </twig:Card>
        {% endif %}
    </div>
{% endif %}
