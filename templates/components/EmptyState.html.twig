{% props icon = 'lucide:inbox', title, description = null %}
<div {{ attributes.defaults({class: 'flex flex-col items-center px-6 py-12 text-center'}) }}>
    <span class="mb-4 flex size-12 items-center justify-center rounded-xl bg-ocean-100 text-ocean-700">
        {{ ux_icon(icon, {class: 'size-6'}) }}
    </span>
    <h3 class="text-lg">{{ title }}</h3>
    {% if description %}<p class="mt-1 max-w-md text-sm text-gray-500">{{ description }}</p>{% endif %}
    <div class="mt-5 empty:hidden">{% block content %}{% endblock %}</div>
</div>
