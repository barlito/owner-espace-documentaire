{# Status and analysis of a document, replaced as a whole by the live updates (see realtime/document_streams.stream.html.twig).
   Rendered by the page and by the worker: it must not use the request nor the logged-in user. #}
{% set status = document.status %}
{% set analysis = client_analysis(document) %}
<section id="document-page-status-{{ document.id }}" aria-labelledby="document-page-analysis-title-{{ document.id }}">
    <twig:Card>
        <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 id="document-page-analysis-title-{{ document.id }}" class="text-lg">Analyse</h2>
            <twig:Badge variant="{{ status.badgeVariant }}" icon="{{ status.icon }}">{{ status.label }}</twig:Badge>
        </div>

        <dl class="mt-4 grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
            <div>
                <dt class="text-gray-500">Nature</dt>
                <dd class="mt-0.5 font-medium text-navy-500">{{ document.type ? document.type.label : 'Non catégorisée' }}</dd>
            </div>
            <div>
                <dt class="text-gray-500">Période</dt>
                <dd class="mt-0.5 font-medium text-navy-500">{{ document.periodStart|period(document.periodEnd)|default('Non déterminée') }}</dd>
            </div>
        </dl>

        <div class="mt-5 border-t border-gray-50 pt-5 text-sm">
            {% if analysis.retryNumber %}
                <p class="mb-3 text-gray-500">L'équipe OWNER a relancé l'analyse de cette pièce (tentative n° {{ analysis.retryNumber }}).</p>
            {% endif %}

            {% if 'pending' == status.value %}
                <p>L'analyse démarre automatiquement : vous n'avez rien à faire. Cette page se met à jour toute seule.</p>
            {% elseif 'processing' == status.value %}
                <p class="flex items-center gap-2">
                    {{ ux_icon('lucide:loader-circle', {class: 'size-4 shrink-0 motion-safe:animate-spin text-info-500'}) }}
                    Analyse en cours… Elle prend quelques instants, cette page se met à jour toute seule.
                </p>
            {% elseif 'analyzed' == status.value %}
                {% if analysis.summary %}
                    <p class="text-base text-navy-500">{{ analysis.summary }}</p>
                {% endif %}
                {% if analysis.fields %}
                    <h3 class="mt-4 text-sm">Informations extraites</h3>
                    <dl class="mt-2 divide-y divide-gray-50 rounded-lg border border-gray-50">
                        {% for field in analysis.fields %}
                            <div class="flex flex-wrap justify-between gap-x-4 gap-y-0.5 px-4 py-2.5">
                                <dt class="text-gray-500">{{ field.label }}</dt>
                                <dd class="font-medium text-navy-500">{{ field.value }}</dd>
                            </div>
                        {% endfor %}
                    </dl>
                {% endif %}
                {% if analysis.detectedType %}
                    <p class="mt-4 text-gray-500">Nature détectée : <span class="font-medium text-navy-500">{{ analysis.detectedType.label }}</span></p>
                {% endif %}
                <p class="mt-4 text-xs text-gray-400">Analyse simulée : dans cette démonstration, le résultat est généré à partir du nom du fichier.</p>
            {% else %}
                <twig:Alert variant="danger" title="L'analyse n'a pas abouti">
                    <p>{{ analysis.failureMessage }}</p>
                    {% if analysis.suggestsNewUpload %}
                        <twig:Button href="{{ path('client_upload') }}" icon="lucide:upload" size="sm" class="mt-3">Déposer une nouvelle version</twig:Button>
                    {% endif %}
                </twig:Alert>
            {% endif %}
        </div>
    </twig:Card>
</section>
