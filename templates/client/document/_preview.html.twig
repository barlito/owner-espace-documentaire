{# Display of the stored file. Static: the file never changes once received. #}
{% set kind = file_kind(document) %}
<section aria-labelledby="document-preview-title">
    <twig:Card>
        <h2 id="document-preview-title" class="text-lg">Aperçu</h2>

        {% if 'Pdf' == kind.name %}
            <iframe
                src="{{ path('client_document_preview', {id: document.id}) }}"
                title="Aperçu de {{ document.originalFilename }}"
                class="mt-4 hidden h-[70vh] min-h-96 w-full rounded-lg border border-gray-50 sm:block"
            ></iframe>
            {# Phones rarely embed a PDF viewer well: open it in the browser's own viewer instead. #}
            <p class="mt-4 sm:hidden">
                <twig:Button href="{{ path('client_document_preview', {id: document.id}) }}" variant="secondary" icon="lucide:eye" target="_blank" rel="noopener">Ouvrir l'aperçu</twig:Button>
            </p>
        {% elseif 'Image' == kind.name %}
            <img
                src="{{ path('client_document_preview', {id: document.id}) }}"
                alt="Aperçu de {{ document.originalFilename }}"
                class="mt-4 max-h-[70vh] w-full rounded-lg border border-gray-50 bg-gray-25 object-contain"
                loading="lazy"
            >
        {% else %}
            <twig:EmptyState icon="{{ kind.icon }}" title="Aperçu non disponible pour ce format" description="Ce format ne peut pas être affiché dans la page. Téléchargez le fichier pour le consulter.">
                <twig:Button href="{{ path('client_document_file', {id: document.id}) }}" icon="lucide:download">Télécharger</twig:Button>
            </twig:EmptyState>
        {% endif %}
    </twig:Card>
</section>
