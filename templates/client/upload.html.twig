{% extends 'base.html.twig' %}

{% block title %}Déposer des pièces{% endblock %}

{% block body %}
    <a href="{{ path('client_dashboard') }}" class="mb-4 inline-flex items-center gap-1.5 rounded text-sm font-medium text-gray-500 hover:text-navy-500">
        {{ ux_icon('lucide:arrow-left', {class: 'size-4'}) }}
        Retour à mon dossier
    </a>

    <div class="mb-8">
        <h1 class="text-3xl">Déposer des pièces</h1>
        <p class="mt-1 text-gray-500">Transmettez vos documents : chaque pièce reçue apparaît ensuite dans votre dossier.</p>
    </div>

    <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <div
            data-controller="upload"
            data-upload-upload-url-value="{{ path('client_upload_file') }}"
            data-upload-token-value="{{ csrf_token('upload') }}"
            data-upload-max-size-value="{{ constant('App\\Upload\\UploadPolicy::MAX_FILE_SIZE') }}"
            data-upload-max-files-value="{{ constant('App\\Upload\\UploadPolicy::MAX_FILES_PER_BATCH') }}"
            data-upload-extensions-value="{{ policy.extensions|json_encode }}"
            data-upload-unsupported-message-value="{{ policy.unsupportedFormatMessage }}"
            data-upload-too-large-message-value="{{ policy.tooLargeMessage }}"
            data-upload-empty-message-value="{{ policy.emptyFileMessage }}"
            data-upload-interrupted-message-value="{{ policy.interruptedMessage }}"
            class="min-w-0 space-y-6"
        >
            <form method="post" action="{{ path('client_upload_batch') }}" enctype="multipart/form-data" data-turbo="false" data-upload-target="form" data-action="submit->upload#preventNativeSubmit">
                <input type="hidden" name="_token" value="{{ csrf_token('upload') }}">

                <div
                    class="rounded-xl border-2 border-dashed border-gray-100 bg-white px-6 py-10 text-center transition-colors motion-reduce:transition-none data-[dragging=true]:border-primary-500 data-[dragging=true]:bg-primary-10"
                    data-upload-target="dropzone"
                    data-action="dragenter->upload#dragEnter dragover->upload#dragOver dragleave->upload#dragLeave drop->upload#drop"
                >
                    <span class="mx-auto mb-4 flex size-12 items-center justify-center rounded-xl bg-ocean-100 text-ocean-700">
                        {{ ux_icon('lucide:upload', {class: 'size-6'}) }}
                    </span>
                    <p class="hidden font-display text-lg font-semibold text-navy-500" data-upload-target="enhanced">Glissez vos fichiers ici</p>
                    <p class="mt-1 hidden text-sm text-gray-500" data-upload-target="enhanced">ou</p>

                    <div class="mt-3 inline-flex">
                        <input
                            type="file"
                            id="upload-files"
                            name="files[]"
                            multiple
                            accept="{{ policy.acceptAttribute }}"
                            class="peer sr-only"
                            data-upload-target="input"
                            data-action="change->upload#select"
                        >
                        <label
                            for="upload-files"
                            class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-lg border border-navy-500 bg-white px-5 py-2.5 font-display font-semibold text-navy-500 transition-colors hover:bg-navy-10 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary-500"
                        >
                            {{ ux_icon('lucide:plus', {class: 'size-4 shrink-0'}) }}
                            Choisir des fichiers
                        </label>
                    </div>

                    <p class="mt-4 text-sm text-gray-500">
                        {{ policy.formatLabels|join(', ') }} · {{ constant('App\\Upload\\UploadPolicy::MAX_FILE_SIZE_MB') }} Mo maximum par fichier · {{ constant('App\\Upload\\UploadPolicy::MAX_FILES_PER_BATCH') }} fichiers maximum par envoi
                    </p>
                </div>

                {# Without JavaScript: one nature for the whole batch and a real submit button. #}
                <div class="mt-6 space-y-4" data-upload-target="fallback">
                    <div>
                        <label for="upload-type" class="mb-1 block text-sm font-medium text-navy-500">Nature des pièces <span class="font-normal text-gray-500">(facultatif)</span></label>
                        <select id="upload-type" name="type" class="w-full rounded-lg border border-gray-100 bg-white px-3 py-2.5 sm:max-w-md">
                            {% include 'client/_type_options.html.twig' with {groups: typeGroups} only %}
                        </select>
                    </div>
                    <twig:Button type="submit" icon="lucide:upload">Envoyer les fichiers</twig:Button>
                </div>
            </form>

            <section class="hidden space-y-4" aria-labelledby="upload-list-title" data-upload-target="listSection">
                <twig:Card :padded="false">
                    <h2 id="upload-list-title" class="border-b border-gray-50 px-5 py-4 text-lg sm:px-6" data-upload-target="listTitle">Pièces à envoyer</h2>
                    <ul class="divide-y divide-gray-50" data-upload-target="list"></ul>
                </twig:Card>

                <div class="flex flex-wrap items-center gap-3" data-upload-target="actions">
                    <twig:Button type="button" icon="lucide:upload" data-upload-target="sendButton" data-action="click->upload#send">
                        <span data-upload-target="sendLabel">Envoyer</span>
                    </twig:Button>
                    <p class="text-sm text-gray-500" data-upload-target="sendHint"></p>
                </div>
            </section>

            <div class="hidden space-y-4" data-upload-target="summary">
                <div class="hidden" data-upload-target="successAlert">
                    <twig:Alert variant="success"><span data-upload-target="successText"></span></twig:Alert>
                </div>
                <div class="hidden" data-upload-target="partialAlert">
                    <twig:Alert variant="warning"><span data-upload-target="partialText"></span></twig:Alert>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    <twig:Button href="{{ path('client_dashboard') }}" data-upload-target="dashboardLink">Voir mon dossier</twig:Button>
                    <twig:Button variant="secondary" type="button" icon="lucide:plus" data-action="click->upload#addMore">Déposer d'autres pièces</twig:Button>
                </div>
            </div>

            <template data-upload-target="rowTemplate">
                <li class="border-l-4 border-transparent px-5 py-4 data-[state=done]:border-success-500 data-[state=done]:bg-success-10 data-[state=interrupted]:border-warning-500 data-[state=invalid]:border-danger-500 data-[state=refused]:border-danger-500 sm:px-6" data-state="pending">
                    <div class="flex flex-wrap items-start gap-x-4 gap-y-3">
                        <span class="mt-0.5 hidden size-9 shrink-0 items-center justify-center rounded-lg bg-gray-25 text-gray-500 sm:flex">
                            {{ ux_icon('lucide:file-text', {class: 'size-5'}) }}
                        </span>
                        <div class="min-w-0 flex-1 basis-52">
                            <p class="truncate font-medium text-navy-500" data-name></p>
                            <p class="text-sm text-gray-500" data-size></p>
                            <p class="mt-1 hidden text-sm font-medium" data-reason></p>
                            <div class="mt-2 flex flex-wrap items-center gap-2">
                                <span data-badge="pending"><twig:Badge variant="neutral" icon="lucide:clock">En attente d'envoi</twig:Badge></span>
                                <span data-badge="sending" class="hidden"><twig:Badge variant="info" icon="lucide:loader-circle" class="[&_svg]:animate-spin motion-reduce:[&_svg]:animate-none">Envoi en cours</twig:Badge></span>
                                {# Replaced by the analysis status, which then follows the document live. #}
                                <span data-badge="done" class="hidden"><twig:Badge variant="success" icon="lucide:circle-check">Reçue</twig:Badge></span>
                                <span data-badge="refused" class="hidden"><twig:Badge variant="danger" icon="lucide:circle-x">Refusée</twig:Badge></span>
                                <span data-badge="invalid" class="hidden"><twig:Badge variant="danger" icon="lucide:circle-x">Refusé</twig:Badge></span>
                                <span data-badge="interrupted" class="hidden"><twig:Badge variant="warning" icon="lucide:triangle-alert">Envoi interrompu</twig:Badge></span>
                                <span class="hidden" data-retry><twig:Button variant="secondary" size="sm" icon="lucide:rotate-ccw" data-action="click->upload#retry">Réessayer</twig:Button></span>
                            </div>
                        </div>
                        <div class="order-last w-full sm:order-none sm:w-64" data-type-field>
                            <label class="sr-only" data-type-label>Nature de la pièce</label>
                            <select class="w-full rounded-lg border border-gray-100 bg-white px-3 py-2 text-sm disabled:cursor-not-allowed disabled:border-gray-50 disabled:bg-gray-25 disabled:text-gray-500" data-type-select>
                                {% include 'client/_type_options.html.twig' with {groups: typeGroups} only %}
                            </select>
                        </div>
                        <button type="button" class="rounded-lg p-2 text-gray-500 hover:bg-navy-25 hover:text-navy-500 disabled:cursor-not-allowed disabled:opacity-50" data-remove data-action="click->upload#remove">
                            {{ ux_icon('lucide:x', {class: 'size-4'}) }}
                            <span class="sr-only" data-remove-label>Retirer</span>
                        </button>
                    </div>
                    <div class="mt-3 hidden" data-progress-wrap>
                        <div class="h-2 overflow-hidden rounded-full bg-gray-50" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-progress>
                            <div class="h-full w-0 rounded-full bg-primary-500 transition-[width] motion-reduce:transition-none" data-progress-bar></div>
                        </div>
                        <p class="mt-1 text-xs text-gray-500" data-progress-text>0 %</p>
                    </div>
                </li>
            </template>
        </div>

        <aside class="space-y-4">
            <twig:Card>
                <h2 class="text-lg">Avant d'envoyer</h2>
                <dl class="mt-4 space-y-3 text-sm">
                    <div>
                        <dt class="font-medium text-navy-500">Formats acceptés</dt>
                        <dd class="mt-0.5 text-gray-500">{{ policy.formatLabels|join(', ') }}</dd>
                    </div>
                    <div>
                        <dt class="font-medium text-navy-500">Taille</dt>
                        <dd class="mt-0.5 text-gray-500">{{ constant('App\\Upload\\UploadPolicy::MAX_FILE_SIZE_MB') }} Mo maximum par fichier</dd>
                    </div>
                    <div>
                        <dt class="font-medium text-navy-500">Quantité</dt>
                        <dd class="mt-0.5 text-gray-500">{{ constant('App\\Upload\\UploadPolicy::MAX_FILES_PER_BATCH') }} fichiers maximum par envoi</dd>
                    </div>
                </dl>
            </twig:Card>
            <twig:Alert variant="info" title="Réception et analyse">
                La réception confirmée ne signifie pas que l'analyse est terminée : elle démarre automatiquement et vous pourrez la suivre dans votre dossier.
            </twig:Alert>
        </aside>
    </div>

    {{ include('realtime/_client_stream.html.twig') }}
{% endblock %}
