{% extends 'base.html.twig' %}

{% block title %}Mon dossier{% endblock %}

{% block body %}
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-3xl">Mon dossier</h1>
            <p class="mt-1 text-gray-500">{{ client.name }}</p>
        </div>
        <twig:Button href="{{ path('client_upload') }}" icon="lucide:upload">Déposer des pièces</twig:Button>
    </div>

    {# The form and the results are siblings: only the results frame is reloaded by a search, so the field being
       typed in is never replaced. The controller also announces the result count and keeps the form in sync with the URL. #}
    <div data-controller="dossier-filters" data-action="turbo:frame-load->dossier-filters#announce">
        {% if not folderEmpty %}
            {{ include('client/_document_filters.html.twig') }}
        {% endif %}

        <turbo-frame id="documents-results" data-turbo-action="advance">
            {{ include('client/_documents_results.html.twig') }}
        </turbo-frame>
    </div>

    {{ include('realtime/_client_stream.html.twig') }}
{% endblock %}
