{% extends 'base.html.twig' %}

{% block title %}Mon dossier{% endblock %}

{% block body %}
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-3xl">Mon dossier</h1>
            <p class="mt-1 text-gray-500">{{ client.name }}</p>
        </div>
        <twig:Button href="{{ path('client_upload') }}" icon="lucide:upload">Déposer des pièces</twig:Button>
    </div>

    {% if documents is empty %}
        <twig:Card>
            <twig:EmptyState
                icon="lucide:folder-open"
                title="Votre dossier est encore vide"
                description="Déposez vos documents comptables, juridiques et sociaux : vous suivrez ici leur réception puis leur analyse."
            >
                <twig:Button href="{{ path('client_upload') }}" icon="lucide:upload">Déposer des pièces</twig:Button>
            </twig:EmptyState>
        </twig:Card>
    {% else %}
        <twig:Card :padded="false">
            <h2 class="border-b border-gray-50 px-5 py-4 text-lg sm:px-6">Dernières pièces reçues</h2>
            <ul class="divide-y divide-gray-50">
                {% for document in documents %}
                    {% set status = document.status %}
                    <li class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 px-5 py-4 sm:px-6">
                        <div class="min-w-0 flex-1 basis-64">
                            <p class="truncate font-medium text-navy-500" title="{{ document.originalFilename }}">{{ document.originalFilename }}</p>
                            <p class="mt-0.5 text-sm text-gray-500">
                                {{ document.type ? document.type.label : 'Non catégorisée' }}
                                · {{ document.uploadedAt|date('d/m/Y \\à H:i') }}
                                · {{ document.size|file_size }}
                            </p>
                        </div>
                        <twig:Badge variant="{{ status.badgeVariant }}" icon="{{ status.icon }}">{{ status.label }}</twig:Badge>
                    </li>
                {% endfor %}
            </ul>
        </twig:Card>
    {% endif %}
{% endblock %}
