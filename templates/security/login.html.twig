{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block page %}
    <div class="grid min-h-screen lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]">
        <aside class="hidden flex-col justify-between bg-linear-to-br from-navy-500 to-ocean-700 p-12 text-white lg:flex">
            <img src="{{ asset('images/owner-logo-white.png') }}" alt="OWNER" width="160" height="24" class="h-6 w-auto self-start">
            <div class="max-w-md">
                <p class="font-display text-4xl leading-tight font-semibold tracking-tight">Transmettez vos pièces, suivez leur analyse.</p>
                <p class="mt-4 text-lg text-ocean-100">Un espace sécurisé pour déposer vos documents comptables, juridiques et sociaux, et savoir à tout moment où ils en sont.</p>
            </div>
            <p class="text-sm text-ocean-100">Espace documentaire OWNER</p>
        </aside>

        <main id="contenu" class="flex items-center justify-center px-4 py-10 sm:px-6">
            <div class="w-full max-w-md">
                <img src="{{ asset('images/owner-logo.png') }}" alt="OWNER" width="120" height="18" class="mb-8 h-[18px] w-auto lg:hidden">

                <twig:Card>
                    <h1 class="text-2xl">Connexion</h1>
                    <p class="mt-1 text-sm text-gray-500">Accédez à votre espace documentaire.</p>

                    {% if error %}
                        <twig:Alert variant="danger" class="mt-5">{{ error.messageKey|trans(error.messageData, 'security') }}</twig:Alert>
                    {% endif %}

                    <form method="post" action="{{ path('app_login') }}" class="mt-6 space-y-5">
                        <div>
                            <label for="username" class="mb-1.5 block text-sm font-medium text-navy-500">Adresse e-mail</label>
                            <input type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="username" {{ last_username ? '' : 'autofocus' }} required
                                   class="block w-full rounded-lg border border-gray-400 bg-white px-3.5 py-2.5 text-base text-gray-900 placeholder:text-gray-300">
                        </div>
                        <div>
                            <label for="password" class="mb-1.5 block text-sm font-medium text-navy-500">Mot de passe</label>
                            <input type="password" id="password" name="_password" autocomplete="current-password" {{ last_username ? 'autofocus' : '' }} required
                                   class="block w-full rounded-lg border border-gray-400 bg-white px-3.5 py-2.5 text-base text-gray-900">
                        </div>
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                        <twig:Button type="submit" class="w-full">Se connecter</twig:Button>
                    </form>
                </twig:Card>

                {% if app.environment == 'dev' %}
                    <section aria-labelledby="demo-accounts" class="mt-6 rounded-lg border border-dashed border-gray-100 bg-white/60 p-4 text-sm text-gray-500">
                        <h2 id="demo-accounts" class="font-sans text-sm font-semibold text-navy-500">Comptes de démonstration</h2>
                        <ul class="mt-2 space-y-1">
                            <li><span class="font-medium text-gray-700">Administrateur</span> : admin@owner.test</li>
                            <li><span class="font-medium text-gray-700">Client</span> : paul@boulangerie-martin.test</li>
                            <li><span class="font-medium text-gray-700">Client</span> : claire@lespetitspas.test</li>
                        </ul>
                        <p class="mt-2">Mot de passe commun : <code class="rounded bg-gray-25 px-1.5 py-0.5 text-gray-700">demo1234</code></p>
                    </section>
                {% endif %}
            </div>
        </main>
    </div>
{% endblock %}
